# Copy to .env for local development (never commit the real .env).

# Required to power the Central Command AI agents (server/command.ts).
# Get a key at https://console.anthropic.com/ → API Keys.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Port the server listens on. Defaults to 5000 locally.
# On Render this is injected automatically — leave it unset there.
# PORT=5000

# ============================================================
# Savora — environment configuration
# Operated by Axiom Technologies Group Ltd
#
# Copy this file to ".env" and fill in the values once you have
# created each account below. Never commit the real ".env".
# ============================================================

# --- App ---
PORT=5000
NODE_ENV=development
APP_URL=https://savora.app

# --- Company (shown in receipts, emails, legal) ---
COMPANY_NAME="Axiom Technologies Group Ltd"
COMPANY_EMAIL="info@axiom-tech.co.uk"

# ------------------------------------------------------------
# 1) PAYMENTS — Stripe  (charge members + bill partners)
#    Create at https://dashboard.stripe.com/register
#    You need: a Stripe account verified for Axiom Technologies Group Ltd,
#    two Products/Prices (Member Monthly £8.99, Member Annual £79),
#    and a webhook pointing at /api/webhooks/stripe.
# ------------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_MEMBER_MONTHLY=price_xxx
STRIPE_PRICE_MEMBER_ANNUAL=price_xxx

# ------------------------------------------------------------
# 2) EMAIL — transactional + marketing sends
#    Recommended: Resend (https://resend.com) or Postmark.
#    Verify the domain axiom-tech.co.uk (SPF/DKIM) so mail sends
#    "from" info@axiom-tech.co.uk and lands in inboxes.
# ------------------------------------------------------------
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_xxx
EMAIL_FROM="Savora <info@axiom-tech.co.uk>"

# ------------------------------------------------------------
# 3) MARKETING / ADS (optional, for automated spend reporting)
#    Create business accounts under Axiom Technologies Group Ltd:
#    - Meta Business Suite (Facebook/Instagram ads)
#    - Google Ads
#    - TikTok for Business
# ------------------------------------------------------------
META_ACCESS_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
TIKTOK_ACCESS_TOKEN=

# ------------------------------------------------------------
# 4) AI COPY (optional) — swap the template generator for Claude
#    Create at https://console.anthropic.com
# ------------------------------------------------------------
ANTHROPIC_API_KEY=

# ------------------------------------------------------------
# 5) AUTH (optional, when you add real member/partner logins)
# ------------------------------------------------------------
SESSION_SECRET=change-me-to-a-long-random-string
